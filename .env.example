# Public browser configuration. Only VITE_* values belong in this file; they are
# compiled into the browser bundle and must never contain privileged credentials.
# Supply the public browser anon key locally.
# Vite development proxies auth through /api and /functions so the httpOnly refresh cookie
# survives reloads on localhost/127.0.0.1. Production builds use this URL directly.
VITE_INSFORGE_BASE_URL=https://umgm5h3b.us-east.insforge.app
VITE_INSFORGE_ANON_KEY=
# Optional direct Deno Subhosting functions URL.
VITE_INSFORGE_FUNCTIONS_URL=https://umgm5h3b.function2.insforge.app
